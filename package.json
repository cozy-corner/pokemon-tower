{
	"name": "pokemon-tower",
	"private": true,
	"type": "module",
	"dependencies": {
		"planck": "1.5.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.2",
		"@resvg/resvg-js": "2.6.2",
		"@types/node": "26",
		"@types/pngjs": "^6.0.5",
		"pngjs": "^7.0.0",
		"typescript": "^7.0.2",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"scripts": {
		"prepare": "git config core.hooksPath .githooks",
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"fetch-sprites": "bun scripts/fetch-sprites.ts",
		"fetch-heights": "bun scripts/fetch-heights.ts",
		"build-shapes": "bun scripts/build-shapes.ts",
		"test": "vitest run",
		"lint": "biome ci .",
		"fmt": "biome check --write .",
		"check": "biome ci . && tsc --noEmit && vitest run"
