#!/bin/sh
# 公開リポジトリにスプライト等の画像を入れない(権利の都合)
bad=$(git diff --cached --name-only --diff-filter=ACMR | grep -Ei '\.(png|jpe?g|gif|webp|bmp|avif|ico|svg)$|(^|/)public/sprites/')
if [ -n "$bad" ]; then
  echo "画像は commit できません:" >&2
  echo "$bad" >&2
  exit 1
fi
bunx biome check --staged --no-errors-on-unmatched
